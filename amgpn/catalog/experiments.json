  "groups": {
    "paper-main": {
      "purpose": "Main method-family comparison corresponding to the paper discussion. Exact reported numbers require the original private settings and trained weights.",
      "members": [
        "pn",
        "gpn",
        "amgpn",
        "feat",
        "unem"
      ],
      "change_axis": "Prototype modeling or episodic adaptation/refinement",
      "control_axes": [
        "backbone architecture settings",
        "class partitions",
        "episode samples",
        "preprocessing",
        "training budget",
        "evaluation protocol"
      ],
      "workflow": "notebooks/evaluation/paper_comparisons.ipynb"
    },
    "merging": {
      "purpose": "Compare merging mechanisms while holding instance initialization fixed.",
      "members": [
        "amgpn",
        "merge-pairwise",
        "merge-hierarchical",
        "merge-dbscan"
      ],
      "change_axis": "Merging rule only",
      "control_axes": [
        "backbone architecture settings",
        "support/query features",
        "distance metric",
        "threshold policy"
      ],
      "workflow": "notebooks/evaluation/merging.ipynb",
      "additional_utility": "amgpn.evaluation.comprehensive.ComprehensiveEvaluator.compare_merging_strategies also includes a no-merging control."
    },
    "initialization-history": {
      "purpose": "Locate historical prototype-construction comparisons. These engines are not automatically controlled ablations.",
      "members": [
        "fixed-kmeans",
        "imp",
        "gmm",
        "amgpn"
      ],
      "change_axis": "Prototype construction plus historical implementation differences",
      "control_axes": [
        "must be revalidated before a fair comparison"
      ],
      "workflow": "notebooks/legacy/imp_and_kmeans.ipynb",
      "controlled_utility": "amgpn.evaluation.comprehensive.ComprehensiveEvaluator.compare_initialization_strategies"
    },
    "secondary-baselines": {
      "purpose": "Additional episodic CNN and matching-network comparisons; separate from the five-method main table.",
      "members": [
        "cnn-nearest",
        "matching"
      ],
      "change_axis": "Backbone/scoring design",
      "control_axes": [
        "class partitions",
        "episode samples",
        "data preprocessing"
      ],
      "workflow": "notebooks/comparisons/cnn_and_matching.ipynb"
    }
  }
